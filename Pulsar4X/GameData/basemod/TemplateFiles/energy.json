[
  {
    "Type": "ComponentTemplate",
    "Payload": {
      "UniqueID": "reactor",
      "Name": "Reactor",
      "Formulas": {
        "Description": "A non refuelable reactor. The highest power per kilogram in the game — the warship core. Pays for it in crew, in fissile fuel, and in being the LOUDEST thing on a ship.",
        "Mass": "PropertyValue('Mass')",
        "Volume": "PropertyValue('Mass')",
        "HTK": "0.5",
        "CrewReq": "Max(2, [Mass] / 500)",
        "ResearchCost": "[Mass] * 0.5",
        "CreditCost": "[Mass]",
        "BuildPointCost": "[Mass]"
      },
      "ResourceCost": {
        "stainless-steel": "[Mass] * 0.5",
        "plastic": "[Mass] * 0.4",
        "copper": "[Mass] * 0.1",
        "fissile-fuels": "PropertyValue('Fuel Consumption') * PropertyValue('Fuel Load Seconds')"
      },
      "ComponentType": "Facility",
      "MountType": "ShipComponent, ShipCargo, Fighter, GroundUnit, Station, PlanetInstallation",
      "CargoTypeID": "general-storage",
      "IndustryTypeID": "component-construction",
      "Properties": [
        {
          "Name": "Mass",
          "Units": "kg",
          "DescriptionFormula": "'Mass of the reactor'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "25000",
          "MinFormula": "1000",
          "StepFormula": "1",
          "PropertyFormula": "1500"
        },
        {
          "Name": "Output vs Economy",
          "Units": "OvE",
          "DescriptionFormula": "'How hard the core is driven. Turn it up for more power out of the same mass — but a hard-driven core burns more fuel FOR EVERY KILOWATT it makes, so the same endurance costs more fuel to load and more fissile fuel to build. Turn it down for a de-rated reactor that sips. Output goes up with the dial; fuel burned per kilowatt goes up with it too, so total burn rises as the SQUARE.'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "2.0",
          "MinFormula": "0.5",
          "StepFormula": "0.1",
          "PropertyFormula": "1"
        },
        {
          "Name": "Power Output",
          "Units": "Kw",
          "DescriptionFormula": "'in Kw'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "50 * [Mass] * PropertyValue('Output vs Economy')"
        },
        {
          "Name": "Fuel Consumption",
          "Units": "kg/s",
          "DescriptionFormula": "'Fuel Consumption kg per second at Max Output'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "PropertyValue('Power Output') * 0.00000000003125 * PropertyValue('Output vs Economy')"
        },
        {
          "Name": "Lifetime",
          "Units": "h",
          "DescriptionFormula": "'How many HOURS of fuel this reactor is built carrying, at full output. Run it at part load and it lasts proportionally longer. When it runs dry it produces nothing — it is not refuelable, so this is the reactor s whole service life.'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "876000",
          "MinFormula": "1",
          "StepFormula": "1",
          "PropertyFormula": "8760"
        },
        {
          "Name": "Fuel Load Seconds",
          "Units": "s",
          "DescriptionFormula": "'The fuel load in SECONDS, which is the unit EnergyGenerationAtb consumes it in.'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "PropertyValue('Lifetime') * 3600"
        },
        {
          "Name": "DB",
          "DescriptionFormula": "''",
          "GuiHint": "None",
          "PropertyFormula": "AtbConstrArgs('fissile-fuels', PropertyValue('Fuel Consumption'), 'electricity', PropertyValue('Power Output'), PropertyValue('Fuel Load Seconds'))",
          "AttributeType": "Pulsar4X.Energy.EnergyGenerationAtb"
        },
        {
          "Name": "Sensor Signature",
          "Units": "unknown",
          "DescriptionFormula": "''",
          "GuiHint": "None",
          "PropertyFormula": "AtbConstrArgs(1700, PropertyValue('Power Output') * 0.1 * [Mass])",
          "AttributeType": "Pulsar4X.Sensors.SensorSignatureAtb"
        }
      ]
    }
  },
