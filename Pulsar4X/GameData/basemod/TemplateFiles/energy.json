  {
    "Type": "ComponentTemplate",
    "Payload": {
      "UniqueID": "steam-turbine-reactor",
      "Name": "Steam Turbine Reactor",
      "Formulas": {
        "Description": "A big fuelled plant that heats water to steam and drives a turbine. Its edge is VOLUME — a thousand times more power per cubic metre than a reactor of the same mass, on three crew. The station and colony plant.",
        "Mass": "PropertyValue('Mass')",
        "Volume": "PropertyValue('Mass') / 1000",
        "HTK": "0.5",
        "CrewReq": "3",
        "ResearchCost": "[Mass] * 0.5",
        "CreditCost": "[Mass]",
        "BuildPointCost": "[Mass]"
      },
      "ResourceCost": {
        "stainless-steel": "PropertyValue('CoreMass') * 0.5 + PropertyValue('GennyMass') * 0.2",
        "fissile-fuels": "PropertyValue('FuelMass')",
        "copper": "PropertyValue('CoreMass') * 0.05 + PropertyValue('GennyMass') * 0.2",
        "aluminium": "PropertyValue('CoreMass') * 0.05 + PropertyValue('GennyMass') * 0.2",
        "graphite": "PropertyValue('CoreMass') * 0.15",
        "nickel": "PropertyValue('CoreMass') * 0.005 + PropertyValue('GennyMass') * 0.1",
        "titanium": "PropertyValue('CoreMass') * 0.005",
        "tungsten": "PropertyValue('GennyMass') * 0.05"
        
      },
      "ComponentType": "Energy Generator",
      "MountType": "ShipComponent, ShipCargo, Fighter, GroundUnit",
      "CargoTypeID": "general-storage",
      "IndustryTypeID": "component-construction",
      "Properties": [
        {
          "Name": "Mass",
          "Units": "kg",
          "DescriptionFormula": "'Mass of the reactor'",
          "GuiHint": "GuiSelectionMaxMinInt",
          "MaxFormula": "500000",
          "MinFormula": "2000",
          "StepFormula": "1",
          "PropertyFormula": "2000"
        },
        {
          "Name": "Core vs Generator",
          "Units": "percent",
          "DescriptionFormula": "'How the plant s mass is split between the reactor CORE and the GENERATOR set. A bigger core makes more power and eats fissile fuel, graphite and titanium; a bigger generator makes less power and eats tungsten and nickel instead. It is a MATERIALS trade, not an efficiency one — fuel duration is fixed at ~12.7 years by design, whatever you set.'",
          "GuiHint": "GuiSelectionMaxMinInt",
          "MaxFormula": "70",
          "MinFormula": "30",
          "StepFormula": "10",
          "PropertyFormula": "50"
        },
        {
          "Name": "CoreMass",
          "Units": "kg",
          "DescriptionFormula": "'Mass of the Core including fuel and shielding'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "[Mass] * PropertyValue('Core vs Generator') * 0.01"
        },
        {
          "Name": "GennyMass",
          "Units": "kg",
          "DescriptionFormula": "'Mass of the Turbine and generator'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "[Mass] - PropertyValue('CoreMass')"
        },
        {
          "Name": "FuelMass",
          "Units": "kg",
          "DescriptionFormula": "'As a percentage of core mass'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "PropertyValue('CoreMass') * 0.6"
        },
        {
          "Name": "Heat per kg",
          "Units": "KW/kg",
          "DescriptionFormula": "'Heat output per kg of fuel'",
          "PropertyFormula": "100"
        },
        {
          "Name": "Core Efficiency",
          "DescriptionFormula": "'Efficiency turning fuel into heat'",
          "PropertyFormula": "1.0"
        },
        {
          "Name": "Generator Efficiency",
          "DescriptionFormula": "'The efficiency of the turbine and generator - TODO this needs linking to tech'",
          "PropertyFormula": "0.8"
        },
        {
          "Name": "Fuel Burn Rate",
          "Units": "",
          "DescriptionFormula": "'Fuel Consumption kg per second at Max Output'",
          "PropertyFormula": "PropertyValue('CoreOutput') / 40e9"
        },
        {
          "Name": "CoreOutput",
          "Units": "KW",
          "DescriptionFormula": "'Heat output of the reactor'",
          "PropertyFormula": "PropertyValue('FuelMass') * PropertyValue('Heat per kg') * PropertyValue('Core Efficiency')"
        },
        {
          "Name": "GeneratorOutput",
          "Units": "KW",
          "DescriptionFormula": "'Electricy output of the generator'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "PropertyValue('CoreOutput') * PropertyValue('Generator Efficiency')"
        },
        {
          "Name": "FuelDuration",
          "Units": "s",
          "DescriptionFormula": "''",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "PropertyValue('FuelMass') / PropertyValue('Fuel Burn Rate')"
        },
        {
          "Name": "DB",
          "GuiHint": "None",
          "PropertyFormula": "AtbConstrArgs(UniqueID('fissile-fuels'), PropertyValue('Fuel Burn Rate'), UniqueID('electricity'), PropertyValue('GeneratorOutput'), PropertyValue('FuelDuration'))",
          "AttributeType": "Pulsar4X.Energy.EnergyGenerationAtb"
        },
        {
          "Name": "Sensor Signature",
          "Units": "unknown",
          "DescriptionFormula": "''",
          "GuiHint": "None",
          "PropertyFormula": "AtbConstrArgs(1700, PropertyValue('CoreOutput'))",
          "AttributeType": "Pulsar4X.Sensors.SensorSignatureAtb"
        }
      ]
    }
  },
  {
    "Type": "ComponentTemplate",
    "Payload": {
      "Name": "Solar Array",
      "UniqueID": "solarArray",
      "Formulas": {
        "Description": "'Generates power from sunlight, effiency tuned to specific wavelengths'",
        "Mass": "PropertyValue('Area') * TechData('tech-panel-density')",
        "Volume": "[Mass] / 2000",
        "HTK": "[Mass] * 0.5",
        "CrewReq": "0",
        "ResearchCost": "[Mass] * 0.5",
        "CreditCost": "[Mass]",
        "BuildPointCost": "[Mass]"
      },
      "ResourceCost": {
        "plastic": "[Mass] * 0.3",
        "copper": "[Mass] * 0.05",
        "aluminium": "[Mass] * 0.2",
        "silicon": "[Mass] * 0.4",
        "rare-earth-elements": "[Mass] * 0.05"
      },
      "ComponentType": "Energy Generation",
      "MountType": "ShipComponent, ShipCargo, PlanetInstallation, Station",
      "IndustryTypeID": "component-construction",
      "CargoTypeID": "general-storage",
      "Properties": [
        {
          "Name": "Area",
          "Units": "m^2",
          "DescriptionFormula": "'Panel surface area, scales power output'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "10000",
          "MinFormula": "1",
          "StepFormula": "1",
          "PropertyFormula": "100"
        },
        {
          "Name": "Ideal Absorption Wavelength",
          "Units": "nm",
          "DescriptionFormula": "'Peak wavelength for optimal absorption'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "2000",
          "MinFormula": "300",
          "StepFormula": "1",
          "PropertyFormula": "550"
        },
        {
          "Name": "Bandwidth",
          "Units": "nm",
          "DescriptionFormula": "'Range around peak; wider reduces peak efficiency but increases versatility'",
          "GuiHint": "GuiSelectionMaxMin",
          "MaxFormula": "TechData('tech-panel-bandwidth')",
          "MinFormula": "TechData('tech-panel-bandwidth') * 0.5",
          "StepFormula": "50",
          "PropertyFormula": "300"
        },
        {
          "Name": "Best Efficiency",
          "Units": "%",
          "DescriptionFormula": "'Absorption efficiency at peak wavelength'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "TechData('tech-panel-efficiency') * ((TechData('tech-panel-bandwidth') * 0.5) / PropertyValue('Bandwidth'))"
        },
        {
          "Name": "Worst Efficiency",
          "Units": "%",
          "DescriptionFormula": "'Absorption efficiency at bandwidth edges'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "PropertyValue('Best Efficiency') * 0.5"
        },
        {
          "Name": "DB",
          "GuiHint": "None",
          "PropertyFormula": "AtbConstrArgs(PropertyValue('Ideal Absorption Wavelength'), PropertyValue('Bandwidth'), PropertyValue('Best Efficiency'), PropertyValue('Worst Efficiency'), PropertyValue('Area'))",
          "AttributeType": "Pulsar4X.Energy.EnergySolarGenerationAtb"
        }
      ]
    }
  }
]