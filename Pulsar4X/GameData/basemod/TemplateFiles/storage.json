  {
    "Type": "ComponentTemplate",
    "Payload": {
      "UniqueID": "spaceport",
      "Name": "Space Port",
      "Formulas": {
        "Description": "Facility for transporting cargo and fuel to ships from the surface of a planet",
        "Mass": "PropertyValue('Size') * 1.0",
        "Volume": "PropertyValue('Size')",
        "HTK": "0.5",
        "CrewReq": "Max(1, PropertyValue('Size') * 0.1)",
        "ResearchCost": "0",
